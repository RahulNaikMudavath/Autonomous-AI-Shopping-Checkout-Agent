# ==============================================================================
# AgentCart Environment Variables Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# --- Application Settings ---
APP_NAME="AgentCart API"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","*"]

# --- Database (PostgreSQL) ---
# Default local Docker URL. Falls back to SQLite if PostgreSQL is unreachable in dev.
DATABASE_URL=postgresql://agentcart:securepass@localhost:5432/agentcart_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT_SECONDS=5

# --- Redis (Ephemeral State & Cache) ---
# Default local Docker URL. Falls back to in-memory mock if Redis is unreachable in dev.
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600
REDIS_TIMEOUT_SECONDS=2

# --- LLM Providers (Reserved for Phase 2+) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=local

# --- Product Discovery & Search (Reserved for Phase 3+) ---
SERPAPI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
LIVE_DISCOVERY_MODE=auto

# --- Payment Gateways & Sandbox (Reserved for Phase 5+) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Observability & Telemetry ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
