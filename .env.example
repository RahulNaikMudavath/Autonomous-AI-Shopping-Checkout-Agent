# AgentCart Production Environment Configuration
# Copy this file to .env and insert your real API keys.

# --------------------------------------------------
# 1. LLM Brain Provider (Choose your preferred provider)
# --------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai # "openai" | "gemini" | "anthropic" | "local"

# --------------------------------------------------
# 2. Live Web Commerce Search APIs
# --------------------------------------------------
# SerpAPI / Google Shopping / Tavily / Brave Search API for live prices across Amazon, Flipkart, Croma, etc.
SERPAPI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
LIVE_DISCOVERY_MODE=auto # "auto" (uses DuckDuckGo/Tavily/SerpAPI) | "sandbox" (merchant-a to d)

# --------------------------------------------------
# 3. Payment Gateway Sandbox (Stripe / Razorpay)
# --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --------------------------------------------------
# 4. Databases & Storage
# --------------------------------------------------
DATABASE_URL=postgresql://agentcart:securepass@localhost:5432/agentcart_db
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------
# 5. LLM Observability & Tracing (Langfuse)
# --------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
